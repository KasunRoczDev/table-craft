{
  // The site runs in Astro and the browser, not in the root program's Node-only lib.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["astro/client", "node"],
    "noUncheckedIndexedAccess": true,
    "paths": { "@table-craft/desktop/*": ["../desktop/src/*"] }
  },
  "include": ["astro.config.ts", "src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist", ".astro"]
}
