---
import config from "virtual:starlight/user-config";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import { CHANGELOG_ROUTE, DOCS_ROUTE, DOWNLOAD_ROUTE } from "../../scripts/site";

const links = [
  { label: "Docs", href: DOCS_ROUTE, optional: true },
  { label: "Download", href: DOWNLOAD_ROUTE, optional: false },
  { label: "Changelog", href: CHANGELOG_ROUTE, optional: true },
];
const path = Astro.url.pathname;
---

<div class="header">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <div class="sl-flex print:hidden">{config.pagefind && <Search />}</div>
  <div class="sl-flex print:hidden right-group">
    <nav class="site-nav sl-flex" aria-label="Site">
      {
        links.map((link) => (
          <a href={link.href} class:list={{ optional: link.optional }} aria-current={path.startsWith(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="sl-hidden md:sl-flex social-icons"><SocialIcons /></div>
    <div class="sl-hidden md:sl-flex"><ThemeSelect /></div>
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }
  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }
  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .site-nav {
    gap: 1.25rem;
    font-size: var(--sl-text-sm);
  }
  .site-nav a {
    color: var(--tc-ink-muted);
    text-decoration: none;
    transition: color var(--tc-motion-fast) ease-out;
  }
  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    color: var(--tc-ink);
  }
  .social-icons::before {
    content: "";
    height: 1.25rem;
    border-inline-start: 1px solid var(--tc-border);
  }
  @media (max-width: 30rem) {
    .site-nav .optional {
      display: none;
    }
  }
  @media (min-width: 50rem) {
    .header {
      display: grid;
      grid-template-columns: minmax(calc(var(--sl-sidebar-width) - var(--sl-nav-pad-x)), auto) 1fr auto;
      align-content: center;
    }
  }
</style>
