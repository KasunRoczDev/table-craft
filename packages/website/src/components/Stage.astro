---
import Shot from "./Shot.astro";
import type { Highlight } from "../../scripts/landing";

interface Props {
  highlights: readonly Highlight[];
}

const { highlights } = Astro.props;
---

<section class="tc-stage" data-stage aria-labelledby="stage-title">
  <h2 id="stage-title" class="tc-section-title">Everything a database IDE does, in one window</h2>
  <div class="tc-stage-tabs" role="tablist" aria-label="Features">
    {
      highlights.map((highlight, index) => (
        <button
          type="button"
          role="tab"
          id={`stage-tab-${index}`}
          aria-controls={`stage-panel-${index}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
        >
          <span class="tc-stage-meter" aria-hidden="true" />
          {highlight.tab ?? highlight.title}
        </button>
      ))
    }
  </div>
  {
    highlights.map((highlight, index) => (
      <article
        class="tc-stage-panel"
        id={`stage-panel-${index}`}
        role="tabpanel"
        aria-labelledby={`stage-tab-${index}`}
        data-active={index === 0 ? "" : undefined}
      >
        <div class="tc-stage-text">
          <h3>{highlight.title}</h3>
          <p>{highlight.text}</p>
          <a href={highlight.href}>
            Read more <span aria-hidden="true">→</span>
          </a>
        </div>
        {highlight.media && <Shot file={highlight.media} clip={highlight.clip} alt={highlight.title} />}
      </article>
    ))
  }
</section>

<script>
  const PROGRESS = "--tc-progress";

  // Without the script every panel stands in the page, one after another, each with its heading.
  for (const stage of document.querySelectorAll<HTMLElement>("[data-stage]")) {
    const tabs = [...stage.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panels = [...stage.querySelectorAll<HTMLElement>("[role=tabpanel]")];
    const videos = panels.map((panel) => panel.querySelector("video"));
    let current = 0;
    let frame = 0;
    // The stage plays as a reel, each clip once and then the next tab, until the reader picks a tab;
    // from then their pick loops, so the page never moves on under someone reading it.
    let touring = true;

    const meter = (): void => {
      const video = videos[current];
      if (!video || video.paused || !(video.duration > 0)) {
        frame = 0;
        return;
      }
      tabs[current]?.style.setProperty(PROGRESS, String(video.currentTime / video.duration));
      frame = requestAnimationFrame(meter);
    };
    const select = (chosen: number, focus: boolean): void => {
      current = chosen;
      tabs.forEach((tab, index) => {
        const active = index === chosen;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        tab.style.setProperty(PROGRESS, "0");
        panels[index]?.toggleAttribute("data-active", active);
        const video = videos[index];
        if (video && !active) video.pause();
        if (video && active) video.currentTime = 0;
      });
      if (focus) tabs[chosen]?.focus();
    };
    const choose = (chosen: number, focus: boolean): void => {
      touring = false;
      for (const video of videos) if (video) video.loop = true;
      select(chosen, focus);
    };

    videos.forEach((video, index) => {
      if (!video) return;
      video.loop = false;
      video.addEventListener("playing", () => {
        if (index === current && frame === 0) frame = requestAnimationFrame(meter);
      });
      video.addEventListener("ended", () => {
        if (touring && index === current) select((index + 1) % tabs.length, false);
      });
    });
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => choose(index, false));
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (step === 0) return;
        event.preventDefault();
        choose((index + step + tabs.length) % tabs.length, true);
      });
    });
    stage.dataset["tabsReady"] = "";
  }
</script>

<style>
  .tc-stage {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(1.5rem, 0.5rem + 4vw, 4rem);
    background: var(--tc-panel);
    border-radius: calc(var(--tc-radius-island) + 0.75rem);
  }
  .tc-stage-tabs {
    display: none;
    gap: 0.375rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  [data-tabs-ready] .tc-stage-tabs {
    display: flex;
  }
  .tc-stage-tabs button {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    flex: none;
    height: 2.5rem;
    padding-inline: 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--tc-ink-muted);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--tc-motion-fast) ease-out,
      color var(--tc-motion-fast) ease-out;
  }
  .tc-stage-tabs button:hover {
    color: var(--tc-ink);
  }
  .tc-stage-tabs button[aria-selected="true"] {
    background: var(--tc-raised);
    color: var(--tc-ink);
  }
  /* How far the playing clip has run, filling its tab as a scrubber would. */
  .tc-stage-meter {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--tc-accent) 18%, transparent);
    transform: scaleX(var(--tc-progress, 0));
    transform-origin: left;
  }
  .tc-stage-tabs button[aria-selected="false"] .tc-stage-meter {
    visibility: hidden;
  }
  .tc-stage-tabs button:focus-visible {
    outline: 2px solid var(--tc-accent);
    outline-offset: 2px;
  }
  .tc-stage-panel {
    display: grid;
    gap: 1.5rem 3rem;
  }
  .tc-stage-panel + .tc-stage-panel {
    margin-top: 3rem;
  }
  [data-tabs-ready] .tc-stage-panel {
    margin-top: 0;
  }
  [data-tabs-ready] .tc-stage-panel:not([data-active]) {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-tabs-ready] .tc-stage-panel[data-active] {
      animation: tc-rise 500ms var(--tc-ease) both;
    }
  }
  .tc-stage-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 40rem;
  }
  .tc-stage-text h3 {
    font-size: var(--sl-text-2xl);
    color: var(--tc-ink);
  }
  .tc-stage-text p {
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--tc-ink);
  }
  .tc-stage-text a {
    color: var(--tc-accent);
    font-weight: 500;
    text-decoration: none;
  }
  .tc-stage-text a:hover {
    text-decoration: underline;
  }
  .tc-stage :global(.tc-shot) {
    background: var(--tc-raised);
  }
  @media (min-width: 64rem) {
    .tc-stage-panel {
      grid-template-columns: 4fr 9fr;
      align-items: center;
    }
  }
</style>
