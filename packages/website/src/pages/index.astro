---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Keys from "../components/Keys.astro";
import Shot from "../components/Shot.astro";
import Reveal from "../components/Reveal.astro";
import SiteFooter from "../components/SiteFooter.astro";
import changelogJson from "../generated/changelog.json";
import logo from "../generated/logo.png";
import { CHORDS, DATABASES, HERO_LEAD, HERO_TITLE, HIGHLIGHTS } from "../../scripts/landing";
import type { Changelog } from "../../scripts/releases";
import { CHANGELOG_ROUTE, DOCS_ROUTE, DOWNLOAD_ROUTE, REPOSITORY_URL, SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from "../../scripts/site";

const changelog = changelogJson as Changelog;
const latest = changelog.entries[0];
const featured = HIGHLIGHTS.filter((highlight) => highlight.media);
const more = HIGHLIGHTS.filter((highlight) => !highlight.media);
---

<StarlightPage frontmatter={{ title: SITE_TITLE, description: SITE_DESCRIPTION, template: "splash", pagefind: false, hero: { title: SITE_TAGLINE } }}>
  <div class="tc-page tc-landing not-content">
    <section class="tc-hero tc-enter">
      <img class="tc-hero-logo" src={logo.src} width="96" height="96" alt="" />
      <h1 class="tc-display">{HERO_TITLE}</h1>
      <p class="tc-lead">{HERO_LEAD}</p>
      <div class="tc-actions">
        <a class="tc-button" data-variant="primary" href={DOWNLOAD_ROUTE} data-download-button>Download</a>
        <a class="tc-button" href={DOCS_ROUTE}>Read the docs</a>
        <a class="tc-button" href={REPOSITORY_URL}>GitHub</a>
      </div>
      {
        latest && (
          <p class="tc-hero-version tc-muted">
            <a href={CHANGELOG_ROUTE}>
              {latest.version} · {new Date(latest.date).toLocaleDateString("en", { dateStyle: "medium" })}
            </a>
          </p>
        )
      }
    </section>

    <Shot class="tc-hero-shot" file="console.gif" alt="A SQL console running a query, with the result grid below" eager />

    <section class="tc-keymap" aria-labelledby="keymap-title">
      <div class="tc-section-head tc-reveal">
        <h2 id="keymap-title" class="tc-section-title">The chords your hands already know</h2>
        <p class="tc-lead">DataGrip's tool windows, layout and shortcuts, on Windows and Linux with Ctrl in place of ⌘.</p>
      </div>
      <ul class="tc-chords tc-reveal-items">
        {
          CHORDS.map((chord) => (
            <li>
              <Keys keys={chord.keys} />
              <span>{chord.action.replace("…", "")}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="tc-databases" aria-labelledby="databases-title">
      <div class="tc-section-head tc-reveal">
        <h2 id="databases-title" class="tc-section-title">Every database is a plugin</h2>
        <p class="tc-lead">
          SQLite and MySQL come in the box and work offline. The rest download from npm the first time you add one.
        </p>
      </div>
      <ul class="tc-database-list tc-reveal-items">
        {
          DATABASES.map((database) => (
            <li style={`--tint: var(--tc-datasource-${database.tint})`}>
              <span class="tc-database-dot" aria-hidden="true" />
              <span class="tc-database-name">{database.name}</span>
              <span class="tc-badge" data-tone={database.builtIn ? "accent" : undefined}>
                {database.builtIn ? "In the box" : "On demand"}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      featured.map((highlight, index) => (
        <section class="tc-feature tc-reveal" data-flip={index % 2 === 1 ? "" : undefined}>
          <div class="tc-feature-text">
            <h2 class="tc-section-title">{highlight.title}</h2>
            <p class="tc-lead">{highlight.text}</p>
            <a class="tc-feature-link" href={highlight.href}>
              Read more <span aria-hidden="true">→</span>
            </a>
          </div>
          {highlight.media && <Shot file={highlight.media} alt={highlight.title} />}
        </section>
      ))
    }

    <section aria-labelledby="more-title">
      <div class="tc-section-head tc-reveal">
        <h2 id="more-title" class="tc-section-title">Built for the daily loop</h2>
      </div>
      <ul class="tc-more tc-reveal-items">
        {
          more.map((highlight) => (
            <li>
              <a href={highlight.href}>
                <h3>{highlight.title}</h3>
                <p>{highlight.text}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="tc-cta tc-reveal">
      <h2 class="tc-section-title">Open a console in a minute</h2>
      <p class="tc-lead">Download the app, add a data source with <Keys keys={["⌘", "N"]} />, and run a query with <Keys keys={["⌘", "↩"]} />.</p>
      <div class="tc-actions">
        <a class="tc-button" data-variant="primary" href={DOWNLOAD_ROUTE}>Download TableCraft</a>
        <a class="tc-button" href={`${DOCS_ROUTE}install/`}>Install guide</a>
      </div>
    </section>

    <SiteFooter />
    <Reveal />
  </div>
</StarlightPage>

<script>
  import { detectPlatform } from "../../scripts/platform";
  import { PLATFORM_NAMES } from "../../scripts/site";

  const platform = detectPlatform(navigator.userAgent, navigator.platform);
  if (platform) {
    for (const button of document.querySelectorAll<HTMLAnchorElement>("[data-download-button]")) {
      button.textContent = `Download for ${PLATFORM_NAMES[platform]}`;
    }
  }
</script>

<style>
  .tc-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .tc-hero-logo {
    width: 4.5rem;
    height: 4.5rem;
  }
  .tc-hero .tc-display {
    max-width: 60rem;
  }
  .tc-hero-version {
    font-size: var(--sl-text-sm);
    font-variant-numeric: tabular-nums;
  }
  .tc-hero-version a {
    color: inherit;
    text-decoration: none;
  }
  .tc-hero-version a:hover {
    color: var(--tc-ink);
  }
  .tc-hero-shot {
    margin-top: calc(var(--tc-section-gap) * -0.6);
  }
  .tc-section-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .tc-chords {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1.75rem 2rem;
    padding: 0;
    list-style: none;
  }
  .tc-chords li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--tc-ink);
  }
  .tc-database-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem 3rem;
    padding: 0;
    list-style: none;
  }
  .tc-database-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--sl-text-lg);
  }
  .tc-database-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--tint);
    flex: none;
  }
  .tc-database-name {
    flex: 1;
    color: var(--tc-ink);
    font-weight: 500;
  }
  .tc-feature {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .tc-feature-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .tc-feature-link {
    color: var(--tc-accent);
    font-weight: 500;
    text-decoration: none;
  }
  .tc-feature-link:hover {
    text-decoration: underline;
  }
  @media (min-width: 60rem) {
    .tc-feature {
      grid-template-columns: 5fr 8fr;
      gap: 4rem;
    }
    .tc-feature[data-flip] {
      grid-template-columns: 8fr 5fr;
    }
    .tc-feature[data-flip] .tc-feature-text {
      order: 2;
    }
  }
  .tc-more {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 2.5rem 2rem;
    padding: 0;
    list-style: none;
  }
  .tc-more a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    text-decoration: none;
  }
  .tc-more h3 {
    font-size: var(--sl-text-lg);
    color: var(--tc-ink);
    transition: color var(--tc-motion-fast) ease-out;
  }
  .tc-more a:hover h3 {
    color: var(--tc-accent);
  }
  .tc-more p {
    line-height: 1.6;
    color: var(--tc-ink-muted);
  }
  .tc-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    background: var(--tc-panel);
    border-radius: calc(var(--tc-radius-island) + 0.5rem);
  }
  .tc-cta .tc-button:not([data-variant]) {
    background: var(--tc-raised);
  }
</style>
